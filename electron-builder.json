{
  "appId": "com.tradepast.desktop",
  "productName": "TradePast",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/main.cjs",
    "package.json",
    "build/tradepast.png"
  ],
  "asar": true,
  "compression": "maximum",
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "TradePast-Setup.exe",
    "icon": "build/tradepast.ico"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "TradePast",
    "uninstallDisplayName": "TradePast",
    "installerIcon": "build/tradepast.ico",
    "uninstallerIcon": "build/tradepast.ico",
    "installerHeaderIcon": "build/tradepast.ico"
  }
}
