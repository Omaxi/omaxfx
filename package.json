{
  "name": "omaxfx-simulator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --test",
    "predev": "node scripts/generate-data-manifest.mjs",
    "prebuild": "node scripts/generate-data-manifest.mjs",
    "prebuild:offline": "node scripts/generate-data-manifest.mjs",
    "build:offline": "vite build --base=./",
    "prebuild:desktop": "node scripts/generate-data-manifest.mjs && node scripts/create-electron-icon.mjs",
    "build:desktop": "vite build --mode desktop",
    "desktop:dev": "concurrently -k \"vite --mode desktop --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "dist:win": "npm run build:desktop && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "canvas-confetti": "^1.9.4",
    "html2canvas": "^1.4.1",
    "html2canvas-pro": "^2.4.4",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.47.0",
    "papaparse": "^5.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "concurrently": "^9.2.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.4.0",
    "sharp": "^0.34.5",
    "wait-on": "^8.0.4"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.omaxfx.simulator",
    "productName": "OmaxFX Simulator",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OmaxFX Simulator",
      "deleteAppDataOnUninstall": false
    }
  }
}
